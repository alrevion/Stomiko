# Приложение обязано быть свежим.
#
# Telegram кеширует вебвью агрессивно: после выкладки правки доезжали через
# раз, а «Reload Page» помогал не всегда. Для врача это значит работать в
# версии недельной давности и не знать об этом — с медицинскими записями
# такое недопустимо.
#
# no-cache — это не «не кешировать», а «спрашивать перед использованием».
# Ответ 304 стоит одного запроса и ничего не весит, а гарантия свежести
# стоит дороже.
/app.js
  Cache-Control: no-cache
/app.css
  Cache-Control: no-cache
/teeth.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
